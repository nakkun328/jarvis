# Copy to .env for your own reference, then export these variables before starting.
JARVIS_DB_PATH=data/jarvis.sqlite3
JARVIS_LOG_LEVEL=INFO

# Explicitly opt in to sending matching approved vault notes to the chat provider.
# JARVIS_MEMORY_VAULT_PATH=/private/path/to/obsidian-vault

# Optional TOML file selecting personality levels (see docs/personality.md); unset uses defaults.
# JARVIS_PERSONALITY_PATH=/private/path/to/personality.toml

# Optional conversation router: off (default), rule, or llm (an extra model call per turn; see docs/router.md).
# JARVIS_ROUTER=off
# With a router AND research enabled/configured, a routed "research" turn starts a research of the
# whole message (sent to the search service). quick (default) or standard; see docs/research.md.
# JARVIS_CHAT_RESEARCH_LEVEL=quick

# Phase 1 OpenAI provider (set these only when enabling it).
JARVIS_LLM_PROVIDER=none
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=

# Single-owner login (see docs/auth.md). Setting the hash turns login on and is required to bind
# a non-loopback address. Create it with: python -m backend.auth.hash_password
# JARVIS_AUTH_PASSPHRASE_HASH=
# At least 32 characters; unset means a random key per start (sessions reset on restart).
# JARVIS_AUTH_SIGNING_KEY=
# JARVIS_AUTH_SESSION_HOURS=168
# false only for plain-HTTP loopback development.
# JARVIS_AUTH_COOKIE_SECURE=true
# JARVIS_TRUSTED_PROXY=1

# Web search is off by default (see docs/research-search.md). Set the key only in your own shell,
# never in this file or in Git.
# JARVIS_SEARCH_PROVIDER=none
# JARVIS_SEARCH_MONTHLY_LIMIT=800

# Optional Gemini provider (set these only when selecting gemini).
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=

# Optional Groq provider (set these only when selecting groq). Copy the model ID from
# GET https://api.groq.com/openai/v1/models; there is no default.
GROQ_API_KEY=
JARVIS_GROQ_MODEL=

# Owner-approved exception (docs/memory.md): approve research memory automatically (needs the vault),
# and stage it when a research session completes (needs JARVIS_RESEARCH_ENABLED). Both default off.
# JARVIS_RESEARCH_MEMORY_AUTO_APPROVE=false
# JARVIS_RESEARCH_MEMORY_AUTO_STAGE=false
