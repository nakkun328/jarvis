# Copy to .env for your own reference, then export these variables before starting.
JARVIS_DB_PATH=data/jarvis.sqlite3
JARVIS_LOG_LEVEL=INFO

# Explicitly opt in to sending matching approved vault notes to the chat provider.
# JARVIS_MEMORY_VAULT_PATH=/private/path/to/obsidian-vault

# Optional TOML file selecting personality levels (see docs/personality.md); unset uses defaults.
# JARVIS_PERSONALITY_PATH=/private/path/to/personality.toml

# Phase 1 OpenAI provider (set these only when enabling it).
JARVIS_LLM_PROVIDER=none
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=

# Optional Gemini provider (set these only when selecting gemini).
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=
